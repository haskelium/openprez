{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["vite/client", "node"],
    "paths": {
      "@core": ["./core/index.ts"],
      "@presentation/deck": ["./presentation/deck"],
      "@showcase/deck": ["./showcase/deck"],
      "@template/*": ["./templates/*/index.ts"]
    }
  },
  "include": [
    "app",
    "core",
    "presentation",
    "showcase",
    "templates",
    "tests",
    "scripts/lib",
    "scripts/standalone/manifest.ts",
    "vite.config.ts"
  ],
  "exclude": ["dist", "node_modules"]
}
